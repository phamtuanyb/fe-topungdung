# Tệp này chỉ dành cho máy cá nhân. Trên máy chủ, mọi biến được truyền qua
# be-topungdung/.env rồi docker-compose đẩy vào lúc build.
#
# NEXT_PUBLIC_* được nướng cứng vào bundle lúc build — đổi thì phải build lại,
# restart không ăn thua. next.config.mjs sẽ chặn build production nếu hai biến
# URL còn trỏ về localhost.

# Backend API base URL
# PROD: https://api.topungdung.net
NEXT_PUBLIC_API_URL=http://localhost:3001

# Site metadata
NEXT_PUBLIC_SITE_NAME=TopỨngDụng
# PROD: https://topungdung.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Khoá cho POST /api/revalidate — BẮT BUỘC, thiếu là endpoint bị khoá.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=
