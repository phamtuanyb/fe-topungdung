# next.js
# Chặn mọi thư mục dựng, không chỉ .next: next.config cho phép đổi distDir qua
# NEXT_DIST_DIR để build thử mà không đụng .next của dev server đang chạy, và
# những thư mục đó (.next-check, .next-kiem...) nặng hàng trăm MB.
/.next
/.next-*/
/out/

# production
/build

